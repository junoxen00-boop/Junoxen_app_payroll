APP_NAME="Junoxen PVT LTD"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://taskdashboard.junoxen.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=HOSTINGER_DATABASE_HOST
DB_PORT=3306
DB_DATABASE=u303244667_taskdashboard
DB_USERNAME=HOSTINGER_DATABASE_USERNAME
DB_PASSWORD=HOSTINGER_DATABASE_PASSWORD
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Optional: set only if Hostinger provides/requires a CA certificate path.
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.junoxen.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@junoxen.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Payroll statutory settings
PAYROLL_PF_EMPLOYEE_RATE_PERCENT=12
PAYROLL_LOP_BASIS=calendar_days
